# ── Backend ────────────────────────────────────────────────────
PORT=13000
BACKEND_URL=http://host.docker.internal:13000

# ── JWT ────────────────────────────────────────────────────────
# Debe coincidir con JWT_SECRET en docker-compose.yml
JWT_SECRET=my-secret-key-change-me

# ── OnlyOffice Instances (separadas por coma) ─────────────────
# El backend distribuye documentos entre estas instancias
ONLYOFFICE_INSTANCES=http://localhost:18080,http://localhost:18081,http://localhost:18082

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:16379

# ── OIDC (Keycloak) ───────────────────────────────────────────
# Realm que emite los tokens de servicio (client credentials)
OIDC_ISSUER=http://localhost:8080/realms/<REALM>
# `aud` que deben traer los tokens del backend cliente
OIDC_AUDIENCE=roffice
# Client propio de Roffice, para llamar a la saveUrl del cliente
OIDC_CLIENT_ID=roffice
OIDC_CLIENT_SECRET=

# ── Clientes autorizados ──────────────────────────────────────
# client_id (claim azp) → endpoint que entrega un PUT prefirmado para guardar
TENANTS={"cliente-backend":{"saveUrl":"http://host.docker.internal:8081/roffice/save-url"}}
