# ── Backend ────────────────────────────────────────────────────
PORT=3000
BACKEND_URL=http://host.docker.internal:3000

# ── JWT ────────────────────────────────────────────────────────
# Debe coincidir con JWT_SECRET en docker-compose.yml
JWT_SECRET=my-secret-key-change-me

# ── OnlyOffice Instances (separadas por coma) ─────────────────
# El backend distribuye documentos entre estas instancias
ONLYOFFICE_INSTANCES=http://localhost:8080,http://localhost:8081,http://localhost:8082

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=development
R2_PREFIX=borradores/
