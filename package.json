{
  "name": "onlyoffice-test",
  "version": "1.0.0",
  "description": "Router de sesiones de edición OnlyOffice para aplicaciones cliente",
  "license": "AGPL-3.0-only",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:local": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "keycloak": "node scripts/keycloak.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2"
  }
}
