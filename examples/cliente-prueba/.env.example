# ── Este tenant de prueba ─────────────────────────────────────
PORT=13100
# URL con la que Roffice alcanza la saveUrl y a la que vuelve el botón del editor
PUBLIC_URL=http://localhost:13100

# ── Roffice (valores del HANDOFF, tabla «Valores de tu tenant») ─
ROFFICE_URL=http://localhost:13000
ROFFICE_TOKEN_ENDPOINT=https://<keycloak>/realms/roffice/protocol/openid-connect/token
ROFFICE_CLIENT_ID=sandbox-backend
ROFFICE_CLIENT_SECRET=
ROFFICE_ISSUER=https://<keycloak>/realms/roffice
ROFFICE_SAVE_AUDIENCE=sandbox-api

# ── Object Storage sandbox (S3 compatible) ───────────────────
# Usa credenciales limitadas a un bucket de pruebas: el cliente solo toca objetos bajo S3_PREFIX.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_PREFIX=roffice-sandbox/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
