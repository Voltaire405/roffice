# Credenciales para scripts/keycloak.js. Copiar a .env.admin (ignorado por git y por Docker).
KEYCLOAK_URL=https://<tu-keycloak>
KEYCLOAK_ADMIN_REALM=master
ROFFICE_REALM=roffice

# Opción recomendada: client de servicio en el realm de admin con rol realm-admin (o create-realm + manage-clients)
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Alternativa: usuario administrador (se usa solo si KEYCLOAK_ADMIN_CLIENT_SECRET está vacío)
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
